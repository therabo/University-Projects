<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="500.0" minWidth="720.0" prefHeight="700.0" prefWidth="1050.0" styleClass="app-root" stylesheets="@mail.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox minWidth="205.0" prefWidth="232.0" spacing="26.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="11.0">
                    <children>
                        <Label text="M" styleClass="brand-mark" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <children>
                                <Label text="MAIL DESK" styleClass="brand-name" />
                                <Label text="La tua posta" styleClass="brand-caption" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="btn_newemail" maxWidth="Infinity" prefHeight="43.0" text="+  Nuova email" styleClass="primary-button" />
                        <Button fx:id="btn_newarrivals" maxWidth="Infinity" prefHeight="42.0" text="↻  Aggiorna posta" styleClass="sidebar-button" />
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="btn_disconnect" maxWidth="Infinity" prefHeight="42.0" text="Esci dalla casella" styleClass="sidebar-button" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="24.0" BorderPane.alignment="CENTER">
            <padding><Insets top="34.0" right="36.0" bottom="34.0" left="36.0" /></padding>
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label text="POSTA ELETTRONICA" styleClass="eyebrow" />
                        <Label text="Posta in arrivo" styleClass="page-title" />
                        <Label text="Leggi i messaggi ricevuti o scrivi una nuova email." styleClass="body-copy" />
                    </children>
                </VBox>
                <VBox spacing="14.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20.0" right="0.0" bottom="4.0" left="0.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <padding><Insets right="22.0" left="22.0" /></padding>
                            <children>
                                <Label text="Messaggi" styleClass="section-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Seleziona un messaggio per leggerlo" styleClass="body-copy" />
                            </children>
                        </HBox>
                        <ListView fx:id="listview_email" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <VBox alignment="CENTER" spacing="9.0">
                                    <children>
                                        <Label text="✉" styleClass="empty-icon" />
                                        <Label text="Nessun messaggio da mostrare" styleClass="section-title" />
                                        <Label text="Aggiorna la posta per verificare nuovi arrivi." styleClass="body-copy" />
                                    </children>
                                </VBox>
                            </placeholder>
                        </ListView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
